{
    // 使用 IntelliSense 了解相关属性。 
    // 悬停以查看现有属性的描述。
    // 欲了解更多信息，请访问: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Train HQ-SAM (MPS)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/train.py",
            "args": [
                "--device",
                "mps",
                "--checkpoint",
                "./pretrained_checkpoint/sam_vit_b_01ec64.pth",
                "--model-type",
                "vit_b",
                "--output",
                "work_dirs/hq_sam_b"
            ],
            "console": "integratedTerminal",
            "justMyCode": true,
            "env": {
                "PYTORCH_ENABLE_MPS_FALLBACK": "1"
            }
        },
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        }
    ]
}